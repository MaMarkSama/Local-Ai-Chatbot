# ── Line API ──────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:9b
OLLAMA_VISION_MODEL=gemma3:9b

# ── ngrok (ถ้ามี Static Domain) ────────────────────────────────────────────
# NGROK_DOMAIN=your-domain.ngrok-free.app

# ── Web Chat ──────────────────────────────────────────────────────────────
WEB_PORT=8001

# ── System Prompt ──────────────────────────────────────────────────────────
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่ฉลาดและเป็นมิตร ตอบคำถามภาษาไทยได้อย่างชัดเจน กระชับ และเป็นประโยชน์ หากไม่แน่ใจให้บอกตรง ๆ เมื่อเขียนโค้ดให้ใส่ภาษาของโค้ดหลัง ``` เสมอ

# ── File Processing ────────────────────────────────────────────────────────
PDF_MAX_CHARS=20000
