# ── Line API ──────────────────────────────────────────────────────────────
# ได้จาก https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── Ollama ────────────────────────────────────────────────────────────────
# URL ของ Ollama (default: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ชื่อ model ที่ใช้ (ดูจาก: ollama list)
# สำหรับ Gemma 4 9B: gemma3:9b หรือ gemma4:9b (แล้วแต่ชื่อที่ pull มา)
OLLAMA_MODEL=gemma3:9b

# ── System Prompt (ปรับแต่งบุคลิก Bot) ──────────────────────────────────
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่ฉลาดและเป็นมิตร ตอบคำถามภาษาไทยได้อย่างชัดเจน กระชับ และเป็นประโยชน์ หากไม่แน่ใจให้บอกตรง ๆ
